  "cards": [
    {
      "dot": "cyan",
      "title": "Main path",
      "items": [
        "PlayerGatherInputSystem writes PlayerMoveInput on GhostOwnerIsLocal only",
        "NetCode Copy/Apply move the float2 through InputBufferData per tick",
        "PlayerMoveSystem runs the same rule on client prediction and server authority"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Honest gather normalizes diagonal length; the wire does not enforce it",
        "PlayerMoveInput.Clamp is the first sim-side bound on |Move|",
        "Without it, Move=(10,0) targets 50 m/s and other clients see the cheat as truth"
      ]
    },
    {
      "dot": "amber",
      "title": "DriveForce is not a speed cap",
      "items": [
        "TargetSpeed (5 m/s) is the chase goal after Clamp",
        "DriveForce (40 N) only clamps impulse per tick — acceleration, not |v|",
        "A forged over-length Move still climbs to an arbitrary ceiling under full authority"
      ]
    }
  ]
