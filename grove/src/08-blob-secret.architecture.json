  "cards": [
    {
      "dot": "rose",
      "title": "Three secrets",
      "items": [
        "1. No edge table \u2014 bake rewrites every wire into a BlobPtr field on the owner node",
        "2. Flat maps \u2014 NodeId \u2192 NodeUnion (Execution or Data header pointer)",
        "3. One shared immutable blob \u2014 entities hold a reference; live state lives in Context"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why it is easy",
      "items": [
        "GraphData is a small shell: Root + Inputs + Outputs + node maps",
        "Walking is follow-pointer, not graph search",
        "Type is an int \u2192 generated switch \u2192 static method (Burst-friendly)"
      ]
    },
    {
      "dot": "cyan",
      "title": "What is NOT in the brick",
      "items": [
        "Entity component data",
        "Per-frame variable values",
        "Graph-local state instances",
        "Those ride in IContext / GroveState, not GraphData"
      ]
    }
  ]
